---
import { cities, site } from "../data/site";
---

<section id="areas" class="bg-ink py-20 text-bone md:py-28">
  <div class="wrap grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
    <div data-reveal>
      <p class="eyebrow mb-4 text-red-bright">Service areas</p>
      <h2 class="max-w-[16ch] text-[clamp(2rem,4.4vw,3.4rem)] leading-[1.02]">
        Phoenix and 23 communities around it.
      </h2>
      <p class="mt-5 max-w-sm text-[0.92rem] leading-relaxed text-bone/65">
        Not on the list? Call {site.phone} — Reyes Roofing works across Arizona,
        not only inside the Valley.
      </p>
    </div>

    <ul class="flex flex-wrap content-start gap-2" data-reveal>
      {
        cities.map((city) => (
          <li>
            <a
              href={city.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center border border-white/15 px-3.5 py-2 text-[0.82rem] text-bone/70 transition-colors hover:border-white/40 hover:text-bone"
            >
              {city.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
