---
import { Image } from "astro:assets";
import { services } from "../data/site";
---

<section id="services" class="bg-bone py-20 md:py-28">
  <div class="wrap">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between" data-reveal>
      <div>
        <p class="eyebrow mb-4">What we do</p>
        <h2 class="max-w-[18ch] text-[clamp(2rem,4.4vw,3.4rem)] leading-[1.02]">
          One roof, four ways in.
        </h2>
      </div>
      <p class="max-w-sm text-[0.95rem] leading-relaxed text-ink/60">
        Tell us what you are seeing. Whether it turns into a repair, a
        maintenance plan or a replacement depends on the roof, not on a script.
      </p>
    </div>

    <ul class="mt-12 grid gap-x-6 gap-y-10 sm:grid-cols-2">
      {
        services.map((service, i) => (
          <li data-reveal>
            <a href={service.href} class="group block">
              <div class="relative aspect-[4/3] overflow-hidden bg-ink/5">
                <Image
                  src={service.img}
                  alt=""
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                  widths={[400, 700]}
                  sizes="(min-width: 640px) 45vw, 92vw"
                  format="webp"
                  quality={62}
                  loading="lazy"
                />
                <span class="absolute left-0 top-0 bg-ink/85 px-3 py-1.5 font-display text-[0.7rem] font-semibold tracking-[0.16em] text-bone">
                  {String(i + 1).padStart(2, "0")}
                </span>
              </div>
              <div class="mt-5 flex items-start justify-between gap-4">
                <div>
                  <h3 class="text-[1.35rem] leading-tight">{service.title}</h3>
                  <p class="mt-2 max-w-sm text-[0.92rem] leading-relaxed text-ink/60">
                    {service.blurb}
                  </p>
                </div>
                <span
                  class="mt-1 shrink-0 text-red transition-transform duration-300 group-hover:translate-x-1"
                  aria-hidden="true"
                >
                  →
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
