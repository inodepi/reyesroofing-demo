---
import { faqs } from "../data/site";
---

<section class="bg-bone py-20 md:py-28">
  <div class="wrap grid gap-10 lg:grid-cols-[0.75fr_1.25fr]">
    <div data-reveal>
      <p class="eyebrow mb-4">Questions</p>
      <h2 class="max-w-[12ch] text-[clamp(2rem,4.4vw,3.4rem)] leading-[1.02]">
        Before you call.
      </h2>
    </div>

    <div class="border-t border-ink/12">
      {
        faqs.map((faq, i) => (
          <details class="group border-b border-ink/12" open={i === 0} data-reveal>
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
              <h3 class="max-w-[38ch] text-[1rem] font-semibold leading-snug md:text-[1.1rem]">
                {faq.q}
              </h3>
              <span
                class="mt-0.5 shrink-0 font-display text-lg leading-none text-red transition-transform duration-300 group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="max-w-[62ch] pb-6 pr-8 text-[0.92rem] leading-relaxed text-ink/65">
              {faq.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
