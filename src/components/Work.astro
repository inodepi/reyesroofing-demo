---
import { Image } from "astro:assets";
import { work } from "../data/site";
---

<section id="work" class="overflow-hidden bg-ink py-20 md:py-28">
  <div class="wrap">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between" data-reveal>
      <div>
        <p class="eyebrow mb-4 text-red-bright">Our work</p>
        <h2 class="max-w-[20ch] text-[clamp(2rem,4.4vw,3.4rem)] leading-[1.02] text-bone">
          Roofs we finished, not stock photos.
        </h2>
      </div>
      <p class="max-w-xs text-[0.9rem] leading-relaxed text-bone/65">
        Shingle, tile and flat systems on Arizona homes and commercial buildings.
      </p>
    </div>
  </div>

  <div
    class="mt-12 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-4 md:px-10 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    data-reveal
  >
    {
      work.map((item) => (
        <figure class="w-[76vw] shrink-0 snap-start sm:w-[44vw] lg:w-[26rem]">
          <Image
            src={item.src}
            alt={item.alt}
            class="aspect-[3/4] w-full object-cover"
            widths={[400, 640]}
            sizes="(min-width: 1024px) 26rem, (min-width: 640px) 44vw, 76vw"
            format="webp"
            quality={58}
            loading="lazy"
          />
        </figure>
      ))
    }
  </div>

  <div class="wrap mt-6">
    <p class="text-[0.75rem] uppercase tracking-[0.18em] text-bone/65">
      Swipe to see more →
    </p>
  </div>
</section>
