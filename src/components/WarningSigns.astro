---
import { warnings } from "../data/site";
---

<section class="bg-ink-soft py-20 text-bone md:py-28">
  <div class="wrap">
    <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between" data-reveal>
      <div>
        <p class="eyebrow mb-4 text-red-bright">Warning signs</p>
        <h2 class="max-w-[22ch] text-[clamp(2rem,4.4vw,3.4rem)] leading-[1.02]">
          Not every roof problem starts with water on the ceiling.
        </h2>
      </div>
      <p class="max-w-xs text-[0.9rem] leading-relaxed text-bone/65">
        Any one of these is worth a look. None of them automatically means a new
        roof.
      </p>
    </div>

    <ul class="mt-12 grid gap-x-10 border-t border-white/10 md:grid-cols-2">
      {
        warnings.map((item) => (
          <li class="border-b border-white/10 py-5" data-reveal>
            <div class="flex items-baseline justify-between gap-6">
              <div>
                <h3 class="text-[1.05rem] text-bone">{item.title}</h3>
                <p class="mt-1 text-[0.88rem] leading-relaxed text-bone/65">
                  {item.body}
                </p>
              </div>
              <a
                href="#services"
                class="shrink-0 font-display text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-bone/55 transition-colors hover:text-bone"
              >
                Services
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
