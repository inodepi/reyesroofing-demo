---
const systems = ["Asphalt shingle", "Tile", "Concrete tile", "Flat & low-slope"];
---

<section class="border-b border-ink/10 bg-bone">
  <div class="wrap flex flex-col gap-5 py-7 md:flex-row md:items-center md:justify-between">
    <p class="text-[0.78rem] uppercase tracking-[0.18em] text-clay">
      Residential &amp; commercial · Phoenix &amp; across Arizona
    </p>
    <ul class="flex flex-wrap gap-2">
      {
        systems.map((s) => (
          <li class="border border-ink/15 px-3 py-1.5 text-[0.78rem] font-medium text-ink/75">
            {s}
          </li>
        ))
      }
    </ul>
  </div>
</section>
