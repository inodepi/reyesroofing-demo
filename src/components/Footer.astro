---
import { site } from "../data/site";
---

<footer class="bg-[#08080a] pb-10 pt-16 text-bone">
  <div class="wrap">
    <div class="grid gap-10 border-b border-white/10 pb-10 md:grid-cols-[1.3fr_1fr_1fr]">
      <div>
        <p class="font-display text-xl font-bold tracking-tight">{site.name}</p>
        <p class="mt-3 max-w-xs text-[0.88rem] leading-relaxed text-bone/60">
          Residential and commercial roofing across Phoenix and Arizona.
        </p>
        <p class="mt-5 text-[0.88rem] text-bone/60">{site.hours}</p>
      </div>

      <div>
        <p class="text-[0.7rem] uppercase tracking-[0.18em] text-bone/65">Contact</p>
        <ul class="mt-4 space-y-2 text-[0.9rem]">
          <li>
            <a href={site.phoneHref} class="hover:text-red-bright">{site.phone}</a>
          </li>
          <li>
            <a href="#estimate" class="text-bone/60 hover:text-bone">Request an estimate</a>
          </li>
        </ul>
      </div>

      <div>
        <p class="text-[0.7rem] uppercase tracking-[0.18em] text-bone/65">Credentials</p>
        <ul class="mt-4 space-y-2 text-[0.9rem] text-bone/60">
          <li>AZ ROC #{site.licenseA}</li>
          <li>AZ ROC #{site.licenseB}</li>
          <li>
            <a
              href="https://www.bbb.org/us/az/phoenix/profile/roofing-contractors/reyes-roofing-llc-1126-1000048804"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-bone">BBB A+ · accredited since {site.bbbSince}</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div class="flex flex-col gap-4 pt-6 text-[0.75rem] text-bone/65 md:flex-row md:items-center md:justify-between">
      <p>© 2026 {site.name}. All rights reserved.</p>
      <p class="max-w-md md:text-right">{site.disclaimer}</p>
    </div>
  </div>
</footer>
