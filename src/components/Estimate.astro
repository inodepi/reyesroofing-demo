---
import { site, services } from "../data/site";

const options = [
  ...services.map((s) => s.title),
  "Not sure — need a look",
];
---

<section id="estimate" class="relative overflow-hidden bg-ink py-20 text-bone md:py-28">
  <div
    class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-red/20 blur-[110px]"
    aria-hidden="true"
  >
  </div>

  <div class="wrap grid gap-12 lg:grid-cols-[0.95fr_1.05fr]">
    <div data-reveal>
      <p class="eyebrow mb-4 text-red-bright">Request an estimate</p>
      <h2 class="max-w-[16ch] text-[clamp(2.1rem,4.6vw,3.5rem)] leading-[1.02]">
        Tell us what your roof is doing.
      </h2>
      <p class="mt-5 max-w-md text-[0.98rem] leading-relaxed text-bone/55">
        You do not need to know what is wrong before you contact us. Describe
        what you see — a stain, missing shingles, a leak that comes back — and
        we will take it from there.
      </p>

      <dl class="mt-10 space-y-5 border-t border-white/10 pt-8 text-[0.9rem]">
        <div class="flex justify-between gap-6">
          <dt class="text-bone/55">Phone</dt>
          <dd>
            <a href={site.phoneHref} class="hover:text-red-bright">{site.phone}</a>
          </dd>
        </div>
        <div class="flex justify-between gap-6">
          <dt class="text-bone/55">Hours</dt>
          <dd class="text-right">{site.hours}</dd>
        </div>
        <div class="flex justify-between gap-6">
          <dt class="text-bone/55">Service area</dt>
          <dd class="text-right">Arizona</dd>
        </div>
      </dl>
    </div>

    <div data-reveal>
      <!-- Demo form: nothing is sent anywhere. Submitting only shows the success state. -->
      <form
        id="estimate-form"
        class="border border-white/10 bg-white/[0.03] p-6 md:p-8"
        novalidate
      >
        <div class="grid gap-5 sm:grid-cols-2">
          <div class="sm:col-span-2 md:col-span-1">
            <label for="name" class="mb-2 block text-[0.75rem] uppercase tracking-[0.14em] text-bone/60">
              Name
            </label>
            <input
              id="name"
              name="name"
              type="text"
              required
              autocomplete="name"
              class="w-full border border-white/15 bg-transparent px-3.5 py-3 text-[0.95rem] text-bone placeholder:text-bone/25 focus:border-bone/50 focus:outline-none"
              placeholder="Your name"
            />
          </div>
          <div class="sm:col-span-2 md:col-span-1">
            <label for="phone" class="mb-2 block text-[0.75rem] uppercase tracking-[0.14em] text-bone/60">
              Phone
            </label>
            <input
              id="phone"
              name="phone"
              type="tel"
              required
              autocomplete="tel"
              inputmode="tel"
              class="w-full border border-white/15 bg-transparent px-3.5 py-3 text-[0.95rem] text-bone placeholder:text-bone/25 focus:border-bone/50 focus:outline-none"
              placeholder="(480) 000-0000"
            />
          </div>
          <div class="sm:col-span-2">
            <label for="email" class="mb-2 block text-[0.75rem] uppercase tracking-[0.14em] text-bone/60">
              Email <span class="normal-case tracking-normal text-bone/55">(optional)</span>
            </label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              class="w-full border border-white/15 bg-transparent px-3.5 py-3 text-[0.95rem] text-bone placeholder:text-bone/25 focus:border-bone/50 focus:outline-none"
              placeholder="you@example.com"
            />
          </div>
          <div class="sm:col-span-2">
            <label for="service" class="mb-2 block text-[0.75rem] uppercase tracking-[0.14em] text-bone/60">
              What do you need?
            </label>
            <select
              id="service"
              name="service"
              class="w-full appearance-none border border-white/15 bg-ink bg-[url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2212%22 height=%228%22 fill=%22none%22 stroke=%22%23b9b3a9%22 stroke-width=%221.5%22><path d=%22M1 1l5 5 5-5%22/></svg>')] bg-[length:12px_8px] bg-[right_1rem_center] bg-no-repeat px-3.5 py-3 pr-10 text-[0.95rem] text-bone focus:border-bone/50 focus:outline-none"
            >
              {options.map((option) => <option value={option}>{option}</option>)}
            </select>
          </div>
          <div class="sm:col-span-2">
            <label for="message" class="mb-2 block text-[0.75rem] uppercase tracking-[0.14em] text-bone/60">
              What are you seeing?
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              class="w-full resize-none border border-white/15 bg-transparent px-3.5 py-3 text-[0.95rem] text-bone placeholder:text-bone/25 focus:border-bone/50 focus:outline-none"
              placeholder="Stain on the ceiling, missing shingles, a leak after rain…"
            ></textarea>
          </div>
        </div>

        <p id="form-error" class="mt-4 hidden text-[0.82rem] text-red-bright" role="alert">
          Add your name and a phone number with at least 10 digits.
        </p>

        <button type="submit" class="btn-red mt-6 w-full">Send my request</button>
        <p class="mt-3 text-center text-[0.7rem] text-bone/55">
          Concept form — submissions aren't sent.
        </p>
      </form>

      <div
        id="estimate-success"
        class="hidden border border-white/10 bg-white/[0.03] p-8 md:p-10"
        tabindex="-1"
      >
        <p class="eyebrow mb-3">Request received</p>
        <h3 class="text-2xl text-bone">Thanks — here's what happens next.</h3>
        <p class="mt-4 text-[0.95rem] leading-relaxed text-bone/60">
          This is a concept form, so nothing was sent. In the live version your
          request goes to Reyes Roofing LLC and they call you back. Today, reach
          them directly:
        </p>
        <a href={site.phoneHref} class="btn-red mt-6 w-full sm:w-auto">
          Call {site.phone}
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("estimate-form") as HTMLFormElement | null;
  const success = document.getElementById("estimate-success") as HTMLElement | null;
  const error = document.getElementById("form-error") as HTMLElement | null;

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get("name") ?? "").trim();
    const phone = String(data.get("phone") ?? "");
    const digits = phone.replace(/\D/g, "");

    if (name.length < 2 || digits.length < 10) {
      error?.classList.remove("hidden");
      form.querySelector<HTMLInputElement>("#phone")?.focus();
      return;
    }

    error?.classList.add("hidden");
    form.classList.add("hidden");
    success?.classList.remove("hidden");
    success?.focus();
  });
</script>
