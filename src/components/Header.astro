---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import { site } from "../data/site";

const nav = [
  { label: "Services", href: "#services" },
  { label: "Our Work", href: "#work" },
  { label: "About", href: "#about" },
  { label: "Areas", href: "#areas" },
];
---

<div class="bg-ink text-bone/55 border-b border-white/5">
  <div class="wrap flex h-9 items-center justify-between text-[0.7rem] tracking-wide">
    <p class="hidden sm:block">{site.hours}</p>
    <p class="sm:hidden">{site.hours}</p>
    <a href={site.phoneHref} class="hover:text-bone transition-colors"
      >{site.phone}</a
    >
  </div>
</div>

<header
  class="sticky top-0 z-40 border-b border-white/10 bg-ink/90 backdrop-blur-md"
>
  <div class="wrap flex h-16 items-center justify-between gap-6 md:h-20">
    <a href="#top" class="flex shrink-0 items-center" aria-label={site.name}>
      <Image
        src={logo}
        alt="Reyes Roofing LLC"
        height={38}
        widths={[192, 288, 384]}
        sizes="(min-width: 768px) 288px, 192px"
        format="webp"
        quality={85}
        class="h-8 w-auto md:h-9"
      />
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="font-display text-[0.78rem] font-semibold uppercase tracking-[0.14em] text-bone/70 transition-colors hover:text-bone"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href={site.phoneHref}
      class="btn-red shrink-0 px-4 py-2.5 text-[0.8rem] md:px-6 md:py-3 md:text-[0.85rem]"
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"
        ></path>
      </svg>
      <span class="hidden sm:inline">Call {site.phone}</span>
      <span class="sm:hidden">Call</span>
    </a>
  </div>
</header>
